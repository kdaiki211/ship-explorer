{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "CMake: build",
			"type": "shell",
			"command": "cmake",
			"args": [
				"-S", ".",
				"-B", "build"
			],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"problemMatcher": [],
		},
		{
			"label": "Make build",
			"type": "shell",
			"command": "make",
			"args": [
				"-C", "build",
				"-j2",
				"ship_explorer"
			],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"problemMatcher": []
		},
		{
			"label": "Make build (ship_explorer only)",
			"type": "shell",
			"command": "make",
			"args": [
				"-C", "build",
				"-j2",
				"ship_explorer"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}